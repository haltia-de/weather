# Maintainer: Mikhail Nevskiy <rensomail@gmail.com>
pkgname=haltia-weather
pkgver=2.1.4
pkgrel=0
pkgdesc="Погода: The weather now and for the days ahead (GTK 3)"
url="https://github.com/haltia-de/weather"
arch="noarch"
# The name before ADR 0004: apk upgrade carries b8k-weather over to this.
provides="b8k-weather=$pkgver-r$pkgrel"
replaces="b8k-weather"
license="GPL-2.0-only"
depends="python3 py3-gobject3 gtk+3.0"
source="$pkgname-$pkgver.tar.gz::https://github.com/haltia-de/weather/archive/v$pkgver.tar.gz"
builddir="$srcdir/weather-$pkgver"

options="!check"

package() {
	sh ./install.sh "$pkgdir" /usr
}

# `abuild checksum` fills this in for a release.
sha512sums="SKIP"
