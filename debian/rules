#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_install:
	sh install.sh $(CURDIR)/debian/haltia-weather /usr
	# The names from before ADR 0004 are for the Haltia tablet only.
	rm -f debian/haltia-weather/usr/bin/b8k-weather \
		debian/haltia-weather/usr/share/applications/io.github.trudenboy.Weather.desktop
